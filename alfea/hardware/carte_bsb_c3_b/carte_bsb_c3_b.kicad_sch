	(text "Seuils (74HC14 sous 3,3 V, VT+ ≤ 2,31 V, VT- ≥ 0,65 V [SUPPOSÉ]) :\nbus montant ≤ 9,3 V ; bus descendant ≥ 2,6 V (rapport 0,248).\nBus haut 11,5 V -> 2,85 V ; 15 V -> 3,72 V (< VCC + 0,5 V)."
		(exclude_from_sim no)
		(at 30.48 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "23341b0b-2ef8-41f4-ad8f-f27e99786644")
	)
	(text "5. Alimentation de U1, portes inutilisées, drapeaux ERC"
		(exclude_from_sim no)
		(at 27.94 185.42 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "27cfcb5e-9bc9-424f-90e6-0f2c3a149b0d")
	)
	(text "U2 : FB relié à la sortie (version 5 V fixe).\nD4 empêche l'USB-C de réalimenter U2."
		(exclude_from_sim no)
		(at 142.24 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "48438b7e-b821-4cd0-a677-2bece18d7015")
	)
	(text "Option B : PAS D'ISOLATION. GND = CL- = X86-2.\nCarte raccordée à la PAC : l'USB-C seulement sur un PC portable sur batterie ou à travers un isolateur USB (doc 15)."
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "48fcb882-edc9-4aa5-b8eb-03f157ecbeee")
	)
	(text "1-2. Entrée X86 (1 = CL+, 2 = CL-, 3 = G+) et alimentation 5 V non isolée"
		(exclude_from_sim no)
		(at 27.94 43.18 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "4f3e1756-6c5b-4a95-9e08-de8fe676321d")
	)
	(text "4. Émission : TX (GPIO7) -> CL+"
		(exclude_from_sim no)
		(at 157.48 114.3 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "81fef759-22bc-4679-a3c1-a06daa044a7d")
	)
	(text "6. ESP32-C3 SuperMini et DHT22 (comme le schéma principal)"
		(exclude_from_sim no)
		(at 284.48 43.18 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c30982bf-35ec-4d48-af62-e7da0f953c4b")
	)
	(text "3. Réception : CL+ -> RX (GPIO6), LED de bus"
		(exclude_from_sim no)
		(at 27.94 114.3 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "cc1d49b1-efa9-4b67-8732-d75338d23bd0")
	)
	(text "J4 / J5 : barrettes femelles du SuperMini.\nJ4-1 5 V, J4-2 GND, J4-3 3V3 ;\nJ5-1 GPIO5 (DHT22), J5-2 GPIO6 (RX), J5-3 GPIO7 (TX)."
		(exclude_from_sim no)
		(at 287.02 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ded9c7b2-c7eb-4b6c-b4d0-396941739e17")
	)
	(text "TX haut (repos) -> Q1 bloqué -> bus libre.\nTX bas -> Q1 conduit -> CL+ tiré à ≈ 0,2 V.\nMême polarité que V3 : aucun changement logiciel."
		(exclude_from_sim no)
		(at 160.02 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ffe9cf53-85b9-4daa-b91c-0965c991ee72")
	)
