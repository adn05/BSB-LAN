/* Modèle des secrets du firmware Alféa.
 * Copier en alfea/config/alfea_secrets.h (ignoré par git) et remplir.
 * Ces valeurs ne servent qu'au premier démarrage : ensuite la NVS fait foi (page /C).
 */
#define ALFEA_WIFI_SSID   "MonReseauWiFi"
#define ALFEA_WIFI_PASS   "MotDePasseWiFi"

// Broker Mosquitto (add-on Home Assistant) : adresse IP ou nom, port 1883.
#define ALFEA_MQTT_BROKER "192.168.1.10:1883"
#define ALFEA_MQTT_USER   "bsblan"
#define ALFEA_MQTT_PASS   "MotDePasseMQTT"

// Authentification HTTP et OTA, sous la forme utilisateur:mot_de_passe. Obligatoire.
#define ALFEA_USER_PASS   "admin:ChangerCeMotDePasse"
#define ALFEA_USER_PASS_DEFINI

// Mot de passe de l'AP de secours « BSB-LAN » (au moins 8 caractères, utilisé à partir de l'étape E4).
#define ALFEA_AP_PASSWORD "ChangerCeMotDePasse"
